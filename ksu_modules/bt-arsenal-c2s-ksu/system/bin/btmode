#!/system/bin/sh
#
# btmode - switch the internal BCM4375B1 between Android and NetHunter Bluetooth
#
# The internal Bluetooth chip hangs off Samsung UART1. Android's stack (Fluoride
# + libbt-vendor) drives it entirely from userspace and never registers a kernel
# HCI device, which is why hciX does not exist under stock. This script hands the
# UART over to the kernel's HCI line discipline instead, so BlueZ tools get a
# real hci0, and hands it back again on the way out.
#
# Only one stack can own the UART at a time, so the two modes are exclusive.
#
# RUN THIS FROM THE ANDROID SHELL, NOT FROM INSIDE THE KALI CHROOT. It drives
# Android services (svc, setprop, getprop) that only work in Android's context.
# The hci0 it creates is global kernel state, so once it is up, BlueZ tools
# inside the chroot see it immediately over AF_BLUETOOTH - nothing needs to be
# shared between the two filesystems for Arsenal to work.
#
# BlueZ itself (btattach, hciconfig, hcitool) normally lives in the chroot, so
# those are invoked through chroot(8). They are glibc-linked and cannot be
# executed directly from Android, which has neither their loader nor libraries.
#
# --- how the chip gets its firmware ------------------------------------------
#
# The BCM4375B1 boots into a ROM firmware that answers HCI commands but cannot
# transmit or receive: it reports BD address AA:AA:AA:AA:AA:AA, HCI Revision
# 0x0, and every scan comes back empty. A patchram blob (.hcd) has to be
# downloaded into it first.
#
# We do NOT load that blob ourselves. BlueZ's hciattach "bcm43xx" handler cannot
# parse Samsung's .hcd files - it times out mid-download and leaves the chip
# wedged until a power cycle. The kernel's own driver can: CONFIG_BT_HCIUART_BCM
# builds hci_bcm.c, whose setup path calls btbcm_setup_patchram() in
# drivers/bluetooth/btbcm.c. So we attach with btattach -P bcm and let the
# kernel do the download.
#
# Three details that are easy to get wrong, all learned the hard way:
#
#  1. The kernel asks for "brcm/<hw_name>.hcd", where hw_name comes from a
#     lookup on the chip's LMP subversion in bcm_uart_subver_table. The
#     BCM4375B1 reports 0x1111, which is not in that table, so hw_name falls
#     back to the literal "BCM" and the file must be named BCM.hcd.
#
#  2. The kernel searches fw_path[], whose first entry is the runtime-settable
#     firmware_class.path. It must be written with printf, never echo: the
#     sysfs store hands the buffer straight to param_set_copystring() with no
#     newline stripping, so "echo" bakes a \n into the middle of every path the
#     loader then builds.
#
#  3. The blob must live somewhere the kernel domain can read under SELinux.
#     /vendor/firmware files are vendor_firmware_file and work; a copy under
#     /data/vendor is vendor_data_file and fails the open with EACCES. This
#     module ships the blob systemlessly into /vendor/firmware/brcm/ for that
#     reason.
#
# Patchram runs from hdev->setup(), which the kernel only calls while the
# HCI_SETUP flag is set - that is, once per registration. "hciconfig hci0 down;
# hciconfig hci0 up" will NOT reload it. Any retry has to detach and re-attach.
#
#   btmode detect      report what was found, change nothing
#   btmode nethunter   give the UART to BlueZ, bring up hci0
#   btmode android     give the UART back to Android's stack
#   btmode status      report which mode is currently active
#
# Overridable via environment: BTMODE_TTY, BTMODE_BAUD, BTMODE_CHROOT,
# BTMODE_BTATTACH, BTMODE_FWDIR, BTMODE_BDADDR, BTMODE_HAL.

BTMODE_TTY="${BTMODE_TTY:-/dev/ttySAC1}"
BTMODE_BAUD="${BTMODE_BAUD:-3000000}"
PIDFILE=/data/local/tmp/btmode-btattach.pid
FW_PATH_PARAM=/sys/module/firmware_class/parameters/path

# See note 1 above - not BCM4375B1.hcd.
FW_NAME=BCM.hcd

log()  { printf '%s\n' "$*"; }
warn() { printf '! %s\n' "$*" >&2; }
die()  { printf '! %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "must run as root"

# --- discovery ---------------------------------------------------------------

# The NetHunter rootfs. BlueZ lives here on a normal install.
find_chroot() {
    if [ -n "$BTMODE_CHROOT" ]; then
        printf '%s\n' "$BTMODE_CHROOT"; return 0
    fi
    for c in /data/local/nhsystem/kali-arm64 /data/local/nhsystem/kalifs \
             /data/local/nhsystem/kali-armhf /data/local/kali-arm64; do
        [ -x "$c/usr/bin/btattach" ] && { printf '%s\n' "$c"; return 0; }
    done
    return 1
}

# Decide how BlueZ tools get run. Sets BLUEZ_MODE to "native" or "chroot".
# Stock Android ships no BlueZ, so chroot is the normal answer.
resolve_bluez() {
    BLUEZ_MODE=""; BLUEZ_ROOT=""
    if [ -n "$BTMODE_BTATTACH" ] && [ -x "$BTMODE_BTATTACH" ]; then
        BLUEZ_MODE=native; BTATTACH_BIN="$BTMODE_BTATTACH"; return 0
    fi
    for p in /system/bin/btattach /system/xbin/btattach /vendor/bin/btattach; do
        [ -x "$p" ] && { BLUEZ_MODE=native; BTATTACH_BIN="$p"; return 0; }
    done
    if BLUEZ_ROOT=$(find_chroot); then
        BLUEZ_MODE=chroot; BTATTACH_BIN="$BLUEZ_ROOT/usr/bin/btattach"; return 0
    fi
    return 1
}

# Run a BlueZ tool, entering the chroot when that is where it lives.
bluez() {
    tool=$1; shift
    case "$BLUEZ_MODE" in
        native) "$(dirname "$BTATTACH_BIN")/$tool" "$@" ;;
        chroot) chroot "$BLUEZ_ROOT" "/usr/bin/$tool" "$@" ;;
        *)      return 127 ;;
    esac
}

# The rfkill switch registered by drivers/bluetooth/bcm43xx.c. Toggling it drives
# the BT_REG_ON GPIO, which is what actually powers the chip.
find_rfkill() {
    for r in /sys/class/rfkill/rfkill*; do
        [ -e "$r/name" ] || continue
        read -r n < "$r/name" 2>/dev/null || continue
        case "$n" in
            *bcm43xx*|*bluetooth*|*Bluetooth*) printf '%s\n' "$r"; return 0 ;;
        esac
    done
    for r in /sys/class/rfkill/rfkill*; do
        [ -e "$r/type" ] || continue
        read -r t < "$r/type" 2>/dev/null || continue
        [ "$t" = bluetooth ] && { printf '%s\n' "$r"; return 0; }
    done
    return 1
}

# Samsung's BT HAL, so we can stop it and make it let go of the UART. The exact
# service name varies across vendor images, so enumerate init's own view.
find_hal() {
    [ -n "$BTMODE_HAL" ] && { printf '%s\n' "$BTMODE_HAL"; return 0; }
    getprop 2>/dev/null | sed -n 's/^\[init\.svc\.\([^]]*\)\].*/\1/p' \
        | grep -i bluetooth | head -n 1
}

# Directory to hand to firmware_class.path: the kernel appends "brcm/$FW_NAME"
# to it. /vendor/firmware is where this module overlays the blob.
find_fw_dir() {
    for d in $BTMODE_FWDIR /vendor/firmware /odm/firmware /data/vendor/bt-fw; do
        [ -f "$d/brcm/$FW_NAME" ] && { printf '%s\n' "$d"; return 0; }
    done
    return 1
}

# The real BD address. Samsung keeps it in efs and writes it from the vendor
# HAL, which we are bypassing, so the chip comes up with a Broadcom placeholder
# (AA:AA:AA:AA:AA:AA unpatched, 43:75:B1:xx:xx:xx once patched) until we set it.
find_bt_addr() {
    [ -n "$BTMODE_BDADDR" ] && { printf '%s\n' "$BTMODE_BDADDR"; return 0; }
    # Not "read < $f": the file is exactly 17 bytes with no trailing newline,
    # and read reports failure at EOF-without-delimiter even after assigning.
    for f in /mnt/vendor/efs/bluetooth/bt_addr /efs/bluetooth/bt_addr; do
        [ -f "$f" ] || continue
        a=$(cat "$f" 2>/dev/null | head -n 1 | tr -d ' \t\r\n')
        case "$a" in
            ??:??:??:??:??:??) printf '%s\n' "$a"; return 0 ;;
        esac
    done
    return 1
}

# Anything still holding the UART will make the attach fail with EBUSY.
#
# Scan per process, never per fd. Globbing /proc/[0-9]*/fd/* and forking a
# readlink for each entry is tens of thousands of forks as root, which takes
# minutes and stalls the poll loop in cmd_nethunter with the HAL already down.
tty_holders() {
    if command -v lsof >/dev/null 2>&1; then
        lsof "$BTMODE_TTY" 2>/dev/null | awk 'NR > 1 { print $2" ("$1")" }'
        return 0
    fi

    for d in /proc/[0-9]*/fd; do
        p=${d#/proc/}; p=${p%/fd}
        ls -l "$d" 2>/dev/null | grep -q -- "-> $BTMODE_TTY\$" || continue
        printf '%s (%s)\n' "$p" \
            "$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)"
    done
}

hci_present() { [ -d /sys/class/bluetooth/hci0 ]; }

# HCI Revision is 0x0 on ROM firmware and non-zero once a patch is resident.
hci_revision() {
    bluez hciconfig -a hci0 2>/dev/null \
        | sed -n 's/.*Revision: \(0x[0-9a-fA-F]*\).*/\1/p' | head -n 1
}

patch_loaded() {
    rev=$(hci_revision)
    [ -n "$rev" ] && [ "$rev" != 0x0 ]
}

# --- power -------------------------------------------------------------------

# rfkill grew a 'soft' attribute (0 = on); older 'state' is inverted (1 = on).
rfkill_set() {
    rk=$1; on=$2
    if [ -w "$rk/soft" ]; then
        if [ "$on" = 1 ]; then printf 0 > "$rk/soft"; else printf 1 > "$rk/soft"; fi
    elif [ -w "$rk/state" ]; then
        printf '%s' "$on" > "$rk/state"
    else
        return 1
    fi
}

# The patch only downloads onto a freshly powered chip, and a failed attach
# leaves it wedged answering nothing, so always cycle rather than just power on.
rfkill_cycle() {
    rk=$1
    rfkill_set "$rk" 0 || return 1
    sleep 1
    rfkill_set "$rk" 1 || return 1
    sleep 1
}

# --- firmware ----------------------------------------------------------------

# See note 2 in the header: printf, never echo.
set_fw_path() {
    [ -w "$FW_PATH_PARAM" ] || return 1
    printf %s "$1" > "$FW_PATH_PARAM"
}

# --- address -----------------------------------------------------------------

# Broadcom vendor Write_BD_ADDR is opcode 0xFC01, so OGF 0x3f / OCF 0x01. HCI
# parameters are little-endian, so the six bytes go in reverse display order.
set_bdaddr() {
    oldifs=$IFS; IFS=:
    # shellcheck disable=SC2086
    set -- $1
    IFS=$oldifs
    [ $# -eq 6 ] || return 1
    bluez hcitool -i hci0 cmd 0x3f 0x01 \
        "0x$6" "0x$5" "0x$4" "0x$3" "0x$2" "0x$1" >/dev/null 2>&1
}

# --- commands ----------------------------------------------------------------

cmd_detect() {
    log "tty            : $BTMODE_TTY $([ -c "$BTMODE_TTY" ] && echo '(present)' || echo '(MISSING)')"
    log "baud           : $BTMODE_BAUD"

    if rk=$(find_rfkill); then
        rn=""; read -r rn < "$rk/name" 2>/dev/null
        pw=""; read -r pw < "$rk/soft" 2>/dev/null
        log "rfkill         : $rk ($rn, soft=$pw)"
    else
        log "rfkill         : NOT FOUND"
    fi

    hal=$(find_hal)
    if [ -n "$hal" ]; then
        log "bluetooth HAL  : $hal (state: $(getprop "init.svc.$hal"))"
    else
        log "bluetooth HAL  : NOT FOUND"
    fi

    if resolve_bluez; then
        if [ "$BLUEZ_MODE" = chroot ]; then
            log "bluez          : chroot $BLUEZ_ROOT (run via chroot)"
        else
            log "bluez          : native $BTATTACH_BIN"
        fi
    else
        log "bluez          : NOT FOUND (no btattach on Android or in a chroot)"
    fi

    if fwdir=$(find_fw_dir); then
        log "patchram (.hcd): $fwdir/brcm/$FW_NAME"
    else
        log "patchram (.hcd): NOT FOUND (looked for brcm/$FW_NAME)"
    fi

    if [ -e "$FW_PATH_PARAM" ]; then
        cur=""; read -r cur < "$FW_PATH_PARAM" 2>/dev/null
        log "firmware path  : ${cur:-<unset>}"
    else
        log "firmware path  : $FW_PATH_PARAM MISSING (kernel lacks fw_path_para)"
    fi

    if addr=$(find_bt_addr); then
        log "bd address     : $addr"
    else
        log "bd address     : NOT FOUND (set BTMODE_BDADDR)"
    fi

    if hci_present; then
        log "hci0           : present (HCI Revision $(hci_revision))"
    else
        log "hci0           : absent"
    fi

    h=$(tty_holders)
    if [ -n "$h" ]; then
        log "tty held by    :"
        printf '%s\n' "$h" | sed 's/^/  /'
    else
        log "tty held by    : nobody"
    fi
}

cmd_nethunter() {
    hci_present && { log "hci0 already up; already in nethunter mode"; return 0; }
    [ -c "$BTMODE_TTY" ] || die "$BTMODE_TTY does not exist (override with BTMODE_TTY)"
    resolve_bluez || die "btattach not found on Android or in a chroot (set BTMODE_BTATTACH or BTMODE_CHROOT)"

    if fwdir=$(find_fw_dir); then
        if set_fw_path "$fwdir"; then
            log "- firmware: $fwdir/brcm/$FW_NAME"
        else
            warn "could not write $FW_PATH_PARAM; chip will run unpatched ROM"
        fi
    else
        warn "no brcm/$FW_NAME found; chip will run unpatched ROM firmware"
        warn "(that means no scanning and a bogus BD address - set BTMODE_FWDIR)"
    fi

    log "- stopping Android Bluetooth"
    svc bluetooth disable 2>/dev/null

    # Give the framework time to stop asking for the HAL. Without this pause
    # hwservicemanager reissues ctl.interface_start within a second of the kill
    # and the service comes straight back.
    sleep 3

    # Keep stopping the HAL until the UART stays free, rather than assuming one
    # ctl.stop wins. The HAL's exit path also drives BT_REG_ON low, so a respawn
    # that dies after we have powered the chip leaves it off and every HCI
    # command times out (BCM: Reset failed -110).
    hal=$(find_hal)
    [ -n "$hal" ] && log "- stopping HAL: $hal"
    i=0
    while [ $i -lt 10 ]; do
        hal=$(find_hal)
        [ -n "$hal" ] && setprop ctl.stop "$hal"

        j=0
        while [ $j -lt 25 ]; do
            [ -z "$(tty_holders)" ] && break
            sleep 0.2
            j=$((j + 1))
        done

        # Require the UART to stay free, not merely be free once.
        if [ -z "$(tty_holders)" ]; then
            sleep 1
            [ -z "$(tty_holders)" ] && break
        fi
        i=$((i + 1))
    done
    h=$(tty_holders)
    [ -n "$h" ] && warn "UART still held, attach may fail: $h"

    # Power last, once nothing is left to tear it down again.
    if rk=$(find_rfkill); then
        log "- power cycling chip via $rk"
        rfkill_cycle "$rk" || warn "rfkill write failed"

        pw=""; read -r pw < "$rk/soft" 2>/dev/null
        if [ "$pw" != 0 ]; then
            warn "chip still powered down after cycle (soft=$pw), retrying"
            rfkill_set "$rk" 1
            sleep 1
        fi
    else
        warn "no rfkill found; chip may be unpowered or still holding old state"
    fi

    log "- attaching: btattach -B $BTMODE_TTY -P bcm -S $BTMODE_BAUD"
    bluez btattach -B "$BTMODE_TTY" -P bcm -S "$BTMODE_BAUD" &
    printf '%s' $! > "$PIDFILE"

    i=0
    while [ $i -lt 50 ]; do
        hci_present && break
        sleep 0.2
        i=$((i + 1))
    done

    hci_present || {
        warn "hci0 did not appear - check 'dmesg | grep -i bluetooth'"
        warn "'Protocol not supported' means the kernel lacks CONFIG_BT_HCIUART_BCM"
        return 1
    }

    # Patchram runs from hdev->setup(), which fires on this open and nowhere
    # else, so this call is where the 176K blob actually goes down the wire.
    # It takes a few seconds.
    log "- bringing hci0 up (this downloads the patchram)"
    if ! bluez hciconfig hci0 up 2>/dev/null; then
        warn "hciconfig hci0 up failed"
        warn "'BCM: Reset failed (-110)' in dmesg means the chip is unpowered:"
        warn "the Android HAL most likely restarted and pulled BT_REG_ON low"
        warn "turn Bluetooth off in Settings, then run 'btmode nethunter' again"
        return 1
    fi

    if patch_loaded; then
        log "- patchram loaded (HCI Revision $(hci_revision))"
    else
        warn "patchram did NOT load (HCI Revision $(hci_revision))"
        warn "chip is on ROM firmware: it will answer commands but never scan"
        warn "check 'dmesg | grep -i bluetooth' for the firmware load error"
    fi

    if addr=$(find_bt_addr); then
        if set_bdaddr "$addr"; then
            bluez hciconfig hci0 reset 2>/dev/null
            log "- bd address set to $addr"
        else
            warn "could not set bd address $addr"
        fi
    else
        warn "no bd address found; chip keeps its Broadcom placeholder"
    fi

    log "hci0 is up - Bluetooth Arsenal can use the internal chip"
}

cmd_android() {
    log "- detaching line discipline"
    bluez hciconfig hci0 down 2>/dev/null
    if [ -f "$PIDFILE" ]; then
        read -r p < "$PIDFILE"
        [ -n "$p" ] && kill "$p" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    killall btattach 2>/dev/null
    sleep 0.5

    rk=$(find_rfkill) && rfkill_set "$rk" 0

    log "- restarting Android Bluetooth"
    hal=$(find_hal)
    [ -n "$hal" ] && setprop ctl.start "$hal"
    svc bluetooth enable 2>/dev/null

    log "handed back to Android - toggle Bluetooth in Settings if it does not come up"
}

cmd_status() {
    if hci_present; then
        log "mode: nethunter (hci0 present, HCI Revision $(hci_revision))"
        resolve_bluez && bluez hciconfig hci0 2>/dev/null
    else
        hal=$(find_hal)
        log "mode: android (no hci0)"
        [ -n "$hal" ] && log "HAL $hal: $(getprop "init.svc.$hal")"
    fi
}

case "$1" in
    detect)    resolve_bluez; cmd_detect ;;
    nethunter) cmd_nethunter ;;
    android)   resolve_bluez; cmd_android ;;
    status|"") resolve_bluez; cmd_status ;;
    *) die "usage: btmode {detect|nethunter|android|status}" ;;
esac
